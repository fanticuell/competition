<Window x:Class="competition.Windows.EditAthlete"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:competition.Windows"
        mc:Ignorable="d"
       Title="Данные атлета и биометрия" Height="480" Width="380" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="ID Атлета (только для новых):" Margin="0,5,0,2" FontWeight="Bold"/>
                <TextBox IsEnabled="False" x:Name="TxtId" Padding="3"/>

                <TextBlock Text="Фамилия:" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtLastName" Padding="3"/>

                <TextBlock Text="Имя:" Margin="0,5,0,2"/>
                <TextBox x:Name="TxtFirstName" Padding="3"/>

                <TextBlock Text="Отчество:" Margin="0,5,0,2"/>
                <TextBox x:Name="TxtMiddleName" Padding="3"/>

                <TextBlock Text="Код страны (например, RUS):" Margin="0,5,0,2"/>
                <TextBox x:Name="TxtCountryCode" Padding="3"/>

                <TextBlock Text="Пол (М/Ж):" Margin="0,5,0,2"/>
                <TextBox x:Name="TxtGender" Padding="3"/>

                <TextBlock Text="Дата рождения:" Margin="0,5,0,2"/>
                <DatePicker x:Name="DpBirthDate"/>

                <TextBlock Text="Очки рейтинга:" Margin="0,5,0,2"/>
                <TextBox x:Name="TxtRankPoints" Text="0" Padding="3"/>

                <!-- БЛОК БИОМЕТРИИ (ВТОРАЯ ТАБЛИЦА) -->
                <Separator Margin="0,15,0,10" Background="Gray"/>
                <TextBlock Text="Биометрические данные" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>

                <TextBlock Text="Рост (см):" Margin="0,5,0,2"/>
                <TextBox x:Name="TxtHeight" Padding="3"/>

                <TextBlock Text="Вес (кг):" Margin="0,5,0,2"/>
                <TextBox x:Name="TxtWeight" Padding="3"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="90" Height="28" Click="BtnSave_Click" Margin="0,0,10,0"/>
            <Button Content="Отмена" Width="90" Height="28" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
